    <string name="place_louvre_price">Desde €22</string>
    <string name="place_louvre_altitude">35 m</string>
    <string name="place_louvre_description">Uno de los museos más visitados del mundo, con colecciones que recorren miles de años de arte, historia y patrimonio cultural.</string>

