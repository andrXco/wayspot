    <string name="place_swiss_alps_altitude">2.061 m</string>
    <string name="place_swiss_alps_description">Una región montañosa con senderos, lagos y miradores que conectan pueblos alpinos con panorámicas de cumbres nevadas.</string>

    <string name="place_central_park_title">Central Park</string>
