    <string name="place_central_park_duration">2–3 horas</string>
    <string name="place_central_park_price">Gratuito</string>
    <string name="place_central_park_altitude">30 m</string>
    <string name="place_central_park_description">Un gran parque urbano con senderos, praderas y espacios culturales que ofrece una pausa natural en el centro de Manhattan.</string>

