    <string name="place_machu_picchu_altitude">2.430 m</string>
    <string name="place_machu_picchu_description">Ciudadela inca del siglo XV situada entre montañas y bosques nublados. Sus terrazas, templos y senderos muestran una de las expresiones más destacadas del patrimonio andino.</string>
    <string name="place_machu_picchu_review">Una visita inolvidable. Llegar temprano permitió disfrutar el paisaje con calma y recorrer los principales sectores.</string>

